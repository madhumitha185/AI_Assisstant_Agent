# Copy this file to ".env" and fill in your key. Never commit the real .env.

# Free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use (fast + free tier available)
GROQ_MODEL=llama-3.3-70b-versatile

# Local, free HuggingFace embedding model (downloaded once, runs on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where ChromaDB stores its persistent index
CHROMA_PERSIST_DIR=chroma_db

# Folder containing the sample syllabus/notes files
DATA_DIR=data

# Chunking parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Number of chunks retrieved per query
RETRIEVER_K=4
